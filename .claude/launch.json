{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "demo",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server/src/cli/dev.ts"
      ],
      "env": {
        "TERRAPREV_STATE": "demo.tfstate",
        "PORT": "4610"
      },
      "port": 4600
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "server"
      ],
      "port": 4610
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "web"
      ],
      "port": 4600
    },
    {
      "name": "snapshot-check",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4620",
        "--bind",
        "127.0.0.1",
        "--directory",
        "out"
      ],
      "port": 4620
    }
  ]
}